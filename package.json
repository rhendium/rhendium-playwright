{
  "name": "rhendium-playwright-workspace",
  "private": true,
  "version": "0.1.4",
  "description": "Rhendium browser downloads and Playwright integration",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test packages/browser/test/browser.test.js packages/browser/test/installer.test.js packages/playwright/test/playwright.test.js",
    "test:integration": "node packages/playwright/test/integration.js"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  },
  "engines": {
    "node": ">=20"
  }
}
